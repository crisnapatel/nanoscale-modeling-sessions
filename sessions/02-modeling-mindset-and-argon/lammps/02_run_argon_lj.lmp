# 1. Initialization
units          lj
atom_style      atomic
dimension       3
boundary        p p p

# 2. Create Atoms
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0


dump Argons_moving all custom 10 Ar.trj id x y z vx vy vz fx fy fz

# 3. Pair Potentials (Lennard-Jones)
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# 4. Equilibration (NVT Ensemble)
velocity        all create 1.0 87287
fix             1 all nvt temp 1.0 1.0 0.1

# 5. Output and Run
thermo          100
run             100000
