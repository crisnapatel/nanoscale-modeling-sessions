# 1. Initialization
units          lj
atom_style      atomic
dimension       3
boundary        p p p

# 2. Create Atoms
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0

group my_group_of_atoms type 1

velocity        my_group_of_atoms create 100.0 64852

write_data Ar_1.data
