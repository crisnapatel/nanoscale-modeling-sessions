units real
dimension 3
boundary p p p

atom_style full

pair_style lj/cut 10.0
pair_modify mix geometric
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff

read_data polymer-water.data


dump em_trj all custom 5 em.trj id mol type x y z vx vy vz fx fy fz

min_style cg
minimize 0.0 1.0e-8 1000 100000

write_data em.data
