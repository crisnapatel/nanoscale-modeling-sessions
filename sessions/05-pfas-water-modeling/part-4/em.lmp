# LJ-only minimization, before adding electrostatics and OPLS 1-4 scaling.
# This follows the commands in em.log. See with_electrostatics for the next stage.
units real
dimension 3
boundary p p p

atom_style full

pair_style lj/cut 10.0
pair_modify mix geometric
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff

read_data polymer-water.data

variable atom_fnorm atom sqrt(fx^2+fy^2+fz^2)

dump em_trj all custom 5 em.trj id mol type x y z vx vy vz fx fy fz v_atom_fnorm

thermo 100
thermo_style custom step pe ke ecoul evdwl density

min_style cg
minimize 0.0 1.0e-8 10000 100000

write_data em.data
